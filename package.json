{
  "name": "vpntui",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bash build.sh",
    "build:amd64": "bun build --compile --minify --target=bun-linux-x64 --outfile=./dist/vui-linux-amd64 ./src/index.tsx",
    "build:arm64": "bun build --compile --minify --target=bun-linux-arm64 --outfile=./dist/vui-linux-arm64 ./src/index.tsx",
    "lint": "oxlint src/*",
    "fmt": "oxfmt src/*",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.2.1",
    "@opentui/react": "^0.2.1",
    "react": "^19.2.4"
  }
}